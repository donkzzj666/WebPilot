# Documentation only: startup reads exported environment, never auto-loads this file.
# WEBAGENT_DATA_DIR=/absolute/local/path/to/data
# WEBAGENT_API_PORT=8000
# WEBAGENT_UI_PORT=5173
# WEBAGENT_PREVIEW_PORT=4173
# Trusted browser network configuration; defaults deny all WebArena origins.
# WEBAGENT_WEBARENA_ORIGINS=[]
# WEBAGENT_NETWORK_DENIED_ORIGINS=[]
# WEBAGENT_NETWORK_ADMIN_PORTS=[]
# Bootstrap overrides (absolute executable paths):
# WEBAGENT_PYTHON=/path/to/python3.12
# WEBAGENT_NODE=/path/to/node
# WEBAGENT_NPM_CLI=/path/to/npm/bin/npm-cli.js
